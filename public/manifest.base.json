{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.0.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "contextMenus",
    "webNavigation",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "background/service-worker.js"
    ]
  },
  "default_locale": "en",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "__MSG_commandToggleTranslation__"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_commandTranslateSelection__"
    },
    "toggle-display-mode": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "__MSG_commandToggleDisplayMode__"
    },
    "toggle-summary": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "__MSG_commandToggleSummary__"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/style.css",
        "lib/franc.bundle.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "foxlate@sanni",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  }
}
